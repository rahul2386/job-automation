DATABASE_URL=postgresql://postgres:your_password@localhost/job_automation

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

GREENHOUSE_BOARDS=airbnb,anthropic,databricks,stripe
LEVER_COMPANIES=netflix,scaleai
JOB_SEARCH_DAYS=7
MIN_MATCH_SCORE=70

APPLICANT_FIRST_NAME=YourFirstName
APPLICANT_LAST_NAME=YourLastName
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=9999999999

PLAYWRIGHT_HEADLESS=true
ENABLE_SCHEDULER=true
JOB_SCHEDULER_INTERVAL_HOURS=24
